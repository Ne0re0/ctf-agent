# Copy to ~/.config/ctf-agent/config.env (or ./.env) and uncomment what you need.
# Every line is commented out: a placeholder left active would be used for real.

# CLIs for the claude-sdk/*, codex/*, grok/* and omp/* backends (command on PATH or a path).
# They use your own logins/config. Shell aliases are not visible here: point
# at the real command or wrapper.
# CLAUDE_CLI=/usr/local/bin/ourclaude
# CODEX_CLI=codex
# GROK_CLI=grok
# OMP_CLI=omp

# CTFd (competition mode, or to submit flags)
# CTFD_URL=https://ctf.example.com
# CTFD_TOKEN=ctfd_your_api_token_here

# API keys, only for API-backed models (google/*, xai/*)
# GEMINI_API_KEY=
# XAI_API_KEY=
