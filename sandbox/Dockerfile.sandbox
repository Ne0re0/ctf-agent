# CTF challenge solver sandbox image.
# Build once: docker build -f sandbox/Dockerfile.sandbox -t ctf-sandbox .

FROM golang:1.23-bookworm AS kerbrute-builder
RUN git clone --depth=1 --branch v1.0.3 https://github.com/ropnop/kerbrute /tmp/kerbrute \
    && cd /tmp/kerbrute \
    && CGO_ENABLED=0 go build -o /kerbrute .

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm

# ── System packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    # Networking
    netcat-openbsd curl wget nmap iputils-ping ldap-utils smbclient samba-common-bin \
    # Binary analysis
    binutils file xxd bsdmainutils binwalk \
    gdb ltrace strace \
    # Forensics / steg / image analysis
    exiftool steghide \
    pngcheck imagemagick \
    # Filesystem forensics
    xfsprogs sleuthkit foremost dcfldd testdisk \
    # Audio / media
    ffmpeg sox \
    # OCR
    tesseract-ocr tesseract-ocr-eng \
    # Crypto / encoding
    openssl libssl-dev \
    # Build tools
    gcc g++ make cmake \
    # Python (system base)
    python3 python3-pip python3-dev \
    # Ruby (for zsteg)
    ruby ruby-dev \
    # Java (for Ghidra headless if mounted)
    default-jre-headless \
    # Misc
    git jq zip unzip ca-certificates ncurses-term \
    # Math libs (required by flatter, cado-nfs, fpylll)
    libgmp-dev libmpfr-dev libfplll-dev libeigen3-dev \
    # z3 solver system lib
    libz3-dev \
    # SageMath (Ubuntu 22.04 ships 9.x, works on aarch64 and amd64)
    sagemath \
    # CADO-NFS build deps
    libhwloc-dev libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Podman (nested containers — run challenge Docker images inside sandbox) ───
# Ubuntu 22.04 needs the kubic repo for podman
RUN apt-get update && apt-get install -y curl gnupg2 \
    && . /etc/os-release \
    && echo "deb https://download.opensuse.org/repositories/devel:/kubic:/libcontainers:/stable/xUbuntu_${VERSION_ID}/ /" \
       > /etc/apt/sources.list.d/devel:kubic:libcontainers:stable.list \
    && curl -fsSL "https://download.opensuse.org/repositories/devel:/kubic:/libcontainers:/stable/xUbuntu_${VERSION_ID}/Release.key" \
       | gpg --dearmor -o /etc/apt/trusted.gpg.d/kubic.gpg \
    && apt-get update && apt-get install -y podman buildah fuse-overlayfs slirp4netns \
    && rm -rf /var/lib/apt/lists/* \
    || echo "Podman install failed (non-fatal) — nested containers will not be available"

# ── radare2 ───────────────────────────────────────────────────────────────────
RUN git clone --depth=1 https://github.com/radareorg/radare2 /tmp/r2 \
    && cd /tmp/r2 && bash sys/install.sh --install \
    && ldconfig \
    && r2 -v \
    && rm -rf /tmp/r2

# ── flatter (fast lattice reduction — Keegan Ryan's fork) ────────────────────
RUN git clone --depth=1 https://github.com/keeganryan/flatter /tmp/flatter \
    && cmake -S /tmp/flatter -B /tmp/flatter/build \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/flatter/build -j$(nproc) \
    && cmake --install /tmp/flatter/build \
    && ldconfig \
    && rm -rf /tmp/flatter

# ── uv (fast Python package manager) ─────────────────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:/root/.local/bin:$PATH"

# ── zsteg ─────────────────────────────────────────────────────────────────────
RUN gem install zsteg

# ── Windows remote shell ──────────────────────────────────────────────────────
RUN gem install evil-winrm

# ── stegseek (build from source — pre-built .deb is amd64 only) ──────────────
RUN apt-get update && apt-get install -y libmhash-dev libmcrypt-dev libjpeg-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth=1 https://github.com/RickdeJager/stegseek /tmp/stegseek \
    && cmake -S /tmp/stegseek -B /tmp/stegseek/build \
    && cmake --build /tmp/stegseek/build --target install \
    && rm -rf /tmp/stegseek

# ── Python CTF libraries (system python3) ────────────────────────────────────
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel
RUN pip3 install --no-cache-dir \
    pwntools \
    pycryptodome \
    sympy \
    gmpy2 \
    requests \
    Pillow \
    z3-solver \
    pytesseract \
    scipy \
    numpy \
    angr \
    capstone \
    unicorn \
    ropgadget \
    tqdm \
    fpylll \
    flask \
    volatility3 \
    PyJWT \
    impacket \
    smbclientng \
    bloodhound \
    pyghidra

# NetExec has its own dependency set and needs a newer Python than Ubuntu 22.04.
RUN uv tool install --python 3.12 'git+https://github.com/Pennyw0rth/NetExec.git@3999b0ab405b7c9e24128e2cd8eb919a35133867'

# ── Windows / Active Directory enumeration ──────────────────────────────────
RUN uv tool install --python /usr/bin/python3 'git+https://github.com/cddmp/enum4linux-ng.git@v1.3.10'
COPY --from=kerbrute-builder /kerbrute /usr/local/bin/kerbrute

# ── PyTorch (CPU-only) + Keras ────────────────────────────────────────────────
RUN pip3 install --no-cache-dir --ignore-installed sympy \
    torch --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --no-cache-dir keras

# ── RsaCtfTool (catch-all automated RSA/factoring attacks) ────────────────────
RUN git clone --depth=1 https://github.com/RsaCtfTool/RsaCtfTool /opt/RsaCtfTool \
    && pip3 install --no-cache-dir /opt/RsaCtfTool

# ── CADO-NFS (Number Field Sieve — large integer factoring + DLP) ─────────────
RUN git clone --depth=1 https://gitlab.inria.fr/cado-nfs/cado-nfs.git /opt/cado-nfs \
    && cd /opt/cado-nfs && make -j$(nproc)
RUN printf '#!/bin/bash\n\
BUILD_PARENT=/opt/cado-nfs/build\n\
H=$(hostname)\n\
if [ ! -d "$BUILD_PARENT/$H" ]; then\n\
  src=$(ls -d "$BUILD_PARENT"/* 2>/dev/null | head -1)\n\
  [ -n "$src" ] && ln -sf "$src" "$BUILD_PARENT/$H"\n\
fi\n\
exec python3 /opt/cado-nfs/cado-nfs.py "$@"\n' > /usr/local/bin/cado-nfs \
    && chmod +x /usr/local/bin/cado-nfs

# ── Tools reference ──────────────────────────────────────────────────────────
COPY sandbox/sandbox-tools.txt /tools.txt

WORKDIR /challenge

# ── QEMU (user + system emulation for foreign-architecture binaries) ─────────
# Run a foreign binary: qemu-<arch> -L /usr/<triplet> ./bin. Each arch gets its base
# runtime libs in /usr/<triplet>/lib: libc, libstdc++, libgcc_s, libatomic, libgomp.
# e.g. qemu-arm -L /usr/arm-linux-gnueabihf ./chall ; debug with qemu-<arch> -g 1234.
# binfmt_misc is set by the host kernel, so call qemu explicitly inside the sandbox.
RUN apt-get update && apt-get install -y \
        qemu-user qemu-user-static qemu-system qemu-utils binfmt-support \
        gdb-multiarch gdbserver patchelf elfutils binutils-multiarch \
    && cross="" \
    && for arch in amd64 i386 armhf armel arm64 mips mipsel mips64el powerpc ppc64el \
                   riscv64 s390x sparc64; do \
           for lib in libc6 libstdc++6 libgcc-s1 libatomic1 libgomp1; do \
               apt-cache show "$lib-$arch-cross" >/dev/null 2>&1 && cross="$cross $lib-$arch-cross"; \
           done; \
       done \
    && apt-get install -y $cross \
    && rm -rf /var/lib/apt/lists/*

# ── pwndbg (portable build: its own multi-arch gdb, Python and pwndbg) ───────
# `gdb` and `pwndbg` both start pwndbg (pwntools' gdb.attach/gdb.debug too);
# the stock gdb stays available as /usr/bin/gdb, plain multi-arch as gdb-multiarch.
ARG PWNDBG_VERSION=2026.10.28
ENV DEBUGINFOD_URLS=""
RUN case "$(uname -m)" in \
        x86_64) arch=x86_64 ;; aarch64) arch=arm64 ;; \
        *) echo "pwndbg: no portable build for $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/pwndbg/pwndbg/releases/download/${PWNDBG_VERSION}/pwndbg_${PWNDBG_VERSION}_${arch}-portable.tar.xz" \
       | tar -xJ -C /opt \
    && ln -sf /opt/pwndbg/bin/pwndbg /usr/local/bin/pwndbg \
    && ln -sf /opt/pwndbg/bin/pwndbg /usr/local/bin/gdb \
    && pwndbg --batch -ex "version" >/dev/null

# ── pwninit (patch a binary to its provided libc/ld) ─────────────────────────
# Release binary is x86_64-only: build it with cargo on other architectures.
ARG PWNINIT_VERSION=3.3.3
RUN if [ "$(uname -m)" = "x86_64" ]; then \
        curl -fsSL -o /usr/local/bin/pwninit \
            "https://github.com/io12/pwninit/releases/download/${PWNINIT_VERSION}/pwninit" \
        && chmod +x /usr/local/bin/pwninit; \
    else \
        apt-get update && apt-get install -y pkg-config libssl-dev liblzma-dev \
        && rm -rf /var/lib/apt/lists/* \
        && export RUSTUP_HOME=/tmp/rustup CARGO_HOME=/tmp/cargo \
        && curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path \
        && /tmp/cargo/bin/cargo install pwninit --version "${PWNINIT_VERSION}" --locked --root /usr/local \
        && rm -rf /tmp/rustup /tmp/cargo; \
    fi \
    && pwninit --version

# ── Keystone (assembler engine, all architectures) ───────────────────────────
# No aarch64 wheel: pip builds it from source with cmake on that architecture.
RUN pip3 install --no-cache-dir keystone-engine \
    && python3 -c "from keystone import Ks, KS_ARCH_X86, KS_MODE_64; Ks(KS_ARCH_X86, KS_MODE_64).asm('nop')"

# ── Per-container virtual clock ───────────────────────────────────────────────
# Docker containers share the host's real clock. Build libfaketime with
# FAKE_SETTIME so `date -s` updates only this container's workspace clock file.
RUN git clone --depth=1 --branch v0.9.14 https://github.com/wolfcw/libfaketime /tmp/libfaketime \
    && make -C /tmp/libfaketime/src all FAKETIME_COMPILE_CFLAGS=-DFAKE_SETTIME \
    && install -Dm0644 /tmp/libfaketime/src/libfaketime.so.1 /usr/local/lib/faketime/libfaketime.so.1 \
    && rm -rf /tmp/libfaketime \
    && mkdir -p /challenge/workspace
ENV LD_PRELOAD=/usr/local/lib/faketime/libfaketime.so.1 \
    FAKETIME_TIMESTAMP_FILE=/challenge/workspace/.ctf-clock \
    FAKETIME_UPDATE_TIMESTAMP_FILE=1 \
    FAKETIME_NO_CACHE=1 \
    FAKETIME_DONT_FAKE_MONOTONIC=1

WORKDIR /challenge
